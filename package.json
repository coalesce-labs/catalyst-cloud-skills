{
  "name": "@catalyst-cloud/cli",
  "version": "0.14.9",
  "description": "Customer skill bundle for Catalyst Cloud, named from the executive's seat \u2014 get set up, see what is happening, see what needs you, run a project, unstick what is stuck \u2014 plus the catalyst CLI that reads through the Catalyst Cloud SDK, writes through the agent proxy, and connects your machine to your cloud account with one command. The skills directory is the roster; this line never counts it.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coalesce-labs/catalyst-cloud-skills.git"
  },
  "homepage": "https://github.com/coalesce-labs/catalyst-cloud-skills#readme",
  "bugs": {
    "url": "https://github.com/coalesce-labs/catalyst-cloud-skills/issues"
  },
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "catalyst": "bin/catalyst.js",
    "catalyst-skills": "bin/catalyst-skills.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "vendor"
  ],
  "catalystCloud": {
    "tenantContractRange": "1.x || 2.x",
    "pinnedNode": "24.21.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "version:sync": "node scripts/sync-plugin-version.mjs",
    "skill-lib:sync": "node scripts/sync-skill-lib.mjs",
    "skills:scan": "node scripts/scan-skills.mjs",
    "evals": "node scripts/run-evals.mjs",
    "paths:check": "node scripts/vendor-paths.mjs --check",
    "prose:check": "node scripts/check-public-prose.mjs",
    "settings:check": "node scripts/vendor-settings.mjs --check"
  },
  "dependencies": {
    "@catalyst-cloud/sdk": "^0.13.1",
    "@clack/prompts": "1.8.1",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
